# Copy to .env and fill credentials. Never commit .env.
# Runtime: development | test | production
FORMAAI_APP_ENV=development
FORMAAI_HOST=127.0.0.1
FORMAAI_PORT=8000
FORMAAI_RELOAD=false
FORMAAI_LOG_LEVEL=info
# Docs default: enabled in development/test, disabled in production.
# FORMAAI_DOCS_ENABLED=false
# JSON list of explicit frontend origins; [] disables cross-origin access.
FORMAAI_CORS_ORIGINS=[]
FORMAAI_CORS_ALLOW_CREDENTIALS=false

# MySQL: password is required; no usable default is supplied.
FORMAAI_MYSQL_HOST=127.0.0.1
FORMAAI_MYSQL_PORT=3306
FORMAAI_MYSQL_DATABASE=formaai
FORMAAI_MYSQL_USER=formaai
FORMAAI_MYSQL_PASSWORD=
FORMAAI_MYSQL_POOL_SIZE=5
FORMAAI_MYSQL_MAX_OVERFLOW=0
FORMAAI_MYSQL_POOL_TIMEOUT=5
FORMAAI_MYSQL_CONNECT_TIMEOUT=3
FORMAAI_MYSQL_READ_TIMEOUT=5
FORMAAI_MYSQL_WRITE_TIMEOUT=5

# Redis URL credentials must be URL-encoded. All timeouts are seconds.
FORMAAI_REDIS_URL=redis://127.0.0.1:6379/0
FORMAAI_REDIS_MAX_CONNECTIONS=10
FORMAAI_REDIS_CONNECT_TIMEOUT=3
FORMAAI_REDIS_SOCKET_TIMEOUT=3

# JWT Double-Token Secrets: must be at least 32 UTF-8 bytes (256 bits) and distinct.
FORMAAI_JWT_ACCESS_SECRET=
FORMAAI_JWT_REFRESH_SECRET=
FORMAAI_JWT_ISSUER=formaai
FORMAAI_JWT_AUDIENCE=formaai-client
FORMAAI_JWT_ACCESS_TTL_SECONDS=300
FORMAAI_JWT_REFRESH_TTL_SECONDS=604800
